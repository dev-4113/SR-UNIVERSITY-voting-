# LOCAL REVIEW WORKFLOW ONLY. Never commit .env.
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-this-with-a-long-random-local-development-secret

# MySQL (create this database by running sql/002_mysql_demo_auth.sql in MySQL Workbench)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace-this-with-your-local-mysql-password
DB_NAME=sr_university_voting_demo

# Test inboxes only. Use a made-up address at example.edu for today's review.
AUTH_MODE=email_otp
AUTH_ALLOWED_DOMAINS=example.edu
AUTH_DEV_CONSOLE_OTP=true

# Optional SMTP: leave blank to print the generated OTP in the server terminal.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=SR University Demo <no-reply@example.edu>

# Enable only for local product review with fictional student details. Never enable for production.
REVIEW_MODE=true
